# Credentials required to log in and edit the resume / upload photos.
SITE_USERNAME=change-me
SITE_PASSWORD=change-me

# Random secret used to sign the login session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_AUTH_SECRET=change-me-too

# Home page "this month" GitHub contribution graph.
# Personal access token only needs the "read:user" scope (classic token),
# or fine-grained "read-only" access to your own account's user profile.
GITHUB_USERNAME=change-me
GITHUB_TOKEN=
